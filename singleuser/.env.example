# Single-user AI Data Conversion Studio — local config.
# The first-run setup wizard writes these for you; you don't normally edit by hand.
# Copy to ".env" only if you'd rather pre-set them.
#
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# AIMS_MODEL=claude-sonnet-5
#
# Optional:
# PORT=8000                 # change the local port
# AIMS_NO_BROWSER=1         # don't auto-open the browser on start
