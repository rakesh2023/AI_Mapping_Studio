# AI Mapping Studio — environment template.
# Copy to server/.env and fill in real values. NEVER commit the real .env
# (it is gitignored). In deployment, inject these as environment variables via
# your platform / secret manager (e.g. Azure Key Vault) instead of shipping .env.
#
# The backend reads everything from os.environ; server/app/core/config.py
# auto-loads server/.env on startup. Real environment variables take precedence.

# --- Claude gateway (required for AI features) ---
ANTHROPIC_BASE_URL=            # corporate/Bedrock gateway base URL
ANTHROPIC_AUTH_TOKEN=          # gateway auth token  (use this OR ANTHROPIC_API_KEY)
# ANTHROPIC_API_KEY=           # alternative to ANTHROPIC_AUTH_TOKEN

# --- Auth / sessions (required for multi-user) ---
AIMS_SECRET_KEY=               # long random string; signs Flask session cookies
AIMS_ADMIN_EMAIL=admin         # seeded admin account (env-bootstrapped)
AIMS_ADMIN_PASSWORD=           # seeded admin password (set a strong value)

# --- Optional ---
# PORT=8000                    # dev server port (default 8000)
# AIMS_SESSION_HOURS=12        # signed-cookie session lifetime
# AIMS_APP_DB=                 # path to the app SQLite DB (default server/aims_app.db)
# AIMS_USAGE_DB=               # path to the AI-usage SQLite DB (default server/aims_usage.db)
# AIMS_MODEL=                  # model id override for the gateway
# AIMS_CSRF_ENABLED=1          # double-submit CSRF guard (default on)
# AIMS_SIGNUP_ENABLED=0        # self-service signup (default off; admins create users)
