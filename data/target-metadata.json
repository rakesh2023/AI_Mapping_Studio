    {
      "name": "Policy",
      "table": "pc_policy",
      "description": "Core policy entity representing a written insurance policy.",
      "fields": [
        {"name":"PublicID","dataType":"varchar","length":20,"mandatory":true,"pk":true,"fk":false,"description":"Globally unique public identifier assigned by the platform.","businessTerm":"Public ID","accepted":null,"default":"auto-generated"},
        {"name":"PolicyNumber","dataType":"varchar","length":20,"mandatory":true,"pk":false,"fk":false,"description":"Business policy number shown to customers/agents.","businessTerm":"Policy Number","accepted":null,"default":null},
        {"name":"PolicyType","dataType":"varchar","length":30,"mandatory":true,"pk":false,"fk":false,"description":"Product/line of business associated with the policy.","businessTerm":"Product","accepted":"PersonalAuto, Homeowners, CommercialPackage, Umbrella, Other","default":null},
        {"name":"Status","dataType":"varchar","length":20,"mandatory":true,"pk":false,"fk":false,"description":"Current lifecycle status of the policy.","businessTerm":"Policy Status","accepted":"Active, Cancelled, Pending, Expired, Unknown","default":null},
        {"name":"EffectiveDate","dataType":"datetime","length":null,"mandatory":true,"pk":false,"fk":false,"description":"Policy term start date.","businessTerm":"Effective Date","accepted":null,"default":null},
        {"name":"ExpirationDate","dataType":"datetime","length":null,"mandatory":true,"pk":false,"fk":false,"description":"Policy term end date.","businessTerm":"Expiration Date","accepted":null,"default":null},
        {"name":"WrittenPremium","dataType":"decimal(18,2)","length":18,"mandatory":true,"pk":false,"fk":false,"description":"Total written premium for the policy term.","businessTerm":"Written Premium","accepted":null,"default":null},
        {"name":"Currency","dataType":"varchar","length":3,"mandatory":true,"pk":false,"fk":false,"description":"ISO currency of the premium.","businessTerm":"Currency","accepted":"USD, CAD, GBP","default":"USD"},
        {"name":"ProducerCode","dataType":"varchar","length":15,"mandatory":false,"pk":false,"fk":true,"description":"Reference code of the producer/agent who sold the policy.","businessTerm":"Producer Code","accepted":null,"default":null},
        {"name":"CreateTime","dataType":"datetime","length":null,"mandatory":true,"pk":false,"fk":false,"description":"Timestamp the record was created in target system.","businessTerm":"Create Time","accepted":null,"default":"system"},
        {"name":"UpdateTime","dataType":"datetime","length":null,"mandatory":false,"pk":false,"fk":false,"description":"Timestamp the record was last updated.","businessTerm":"Update Time","accepted":null,"default":"system"},
        {"name":"BranchOffice","dataType":"varchar","length":10,"mandatory":false,"pk":false,"fk":false,"description":"Sample field: originating branch/office code.","businessTerm":"Branch Office","accepted":null,"default":null}
